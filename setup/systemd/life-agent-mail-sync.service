[Unit]
Description=life-agent: fetch new/changed mail from Gmail
After=network-online.target
Wants=network-online.target

# TEMPLATE — substitute __OWNER__, __CODE_DIR__, __DATA_DIR__, __CONF_DIR__,
# __STATE_DIR__ and __CLAUDE_BIN_DIR__ before installing. See setup/README.md.
# This repo deliberately contains no path to a real installation.

[Service]
Type=oneshot
User=life-agent
Group=life-agent
UMask=0077
WorkingDirectory=__CODE_DIR__
Environment=HOME=/var/lib/life-agent
Environment=LIFE_AGENT_DATA=__DATA_DIR__
Environment=LIFE_AGENT_CONF=__CONF_DIR__
Environment=LIFE_AGENT_STATE=__STATE_DIR__
Environment=PATH=/usr/bin:/bin:__CODE_DIR__/.venv/bin:__CLAUDE_BIN_DIR__
# --no-embed: embedding runs as its own low-priority unit, life-agent-mail-embed
# (docs/plans/mail-personal-v1.md stage 2), so a slow CPU embed never delays the copy.
ExecStart=__CODE_DIR__/.venv/bin/python -m src.mail.cli sync --budget 600 --no-embed

# Defence in depth — the mail-specific state (mail.db, tokens) is what this run
# actually depends on being locked down; these narrow the blast radius further.
# MemoryDenyWriteExecute is deliberately OMITTED: it breaks CUDA and torch's oneDNN
# CPU kernels, and `sync` without --no-embed (run by hand) still embeds in-process.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__STATE_DIR__
# load_credentials() rewrites the readonly token on refresh — the specific file, not
# the whole (owner-owned) __CONF_DIR__.
ReadWritePaths=__CONF_DIR__/gmail-readonly-token.json
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

TimeoutStartSec=15min
