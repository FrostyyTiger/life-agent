[Unit]
Description=life-agent: assert today's brief exists

# TEMPLATE — substitute __OWNER__, __CODE_DIR__ and __DATA_DIR__ before installing.
#
# Runs as the owner, NOT as life-agent. The watchdog must not share a failure domain
# with the thing it watches: a process that could not start also cannot report that it
# could not start. See docs/failure-modes.md.

[Service]
Type=oneshot
User=__OWNER__
Environment=LIFE_AGENT_DATA=__DATA_DIR__
ExecStart=__CODE_DIR__/setup/deadman.sh
