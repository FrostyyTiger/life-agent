[Unit]
Description=life-agent: read-only mail query socket
After=network.target

# TEMPLATE — substitute __CODE_DIR__, __DATA_DIR__, __CONF_DIR__ and __STATE_DIR__
# before installing. See setup/README.md.
#
# This is the owner's ONLY path into the archive once bootstrap locks mail.db down to
# the life-agent user (docs/trust-model.md). Always on, not timer-triggered — the
# socket file is created at startup and must persist for `mail search`/`show`/`status`
# to fall back to it at any time of day.

[Service]
Type=simple
User=life-agent
Group=life-agent
UMask=0007
WorkingDirectory=__CODE_DIR__
Environment=HOME=/var/lib/life-agent
Environment=LIFE_AGENT_DATA=__DATA_DIR__
Environment=LIFE_AGENT_CONF=__CONF_DIR__
Environment=LIFE_AGENT_STATE=__STATE_DIR__
Environment=PATH=/usr/bin:/bin:__CODE_DIR__/.venv/bin
ExecStart=__CODE_DIR__/.venv/bin/python -m src.mail.cli serve
Restart=on-failure
RestartSec=10
# /run/life-agent itself is created by bootstrap's tmpfiles.d entry, not here — this
# unit only needs write access to place the socket file inside it.

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# NOT ReadOnlyPaths=__STATE_DIR__: that bind-mounts the directory read-only at the OS
# level, and SQLite can still need to create a -shm file for WAL locking on a purely
# logical read-only connection — a read-only mount blocks that outright and serve.py
# fails to open the db. The actual read-only guarantee is `mode=ro` in serve.py's own
# sqlite3.connect() URI (application-level, and the thing that matters); the OS-level
# grant just needs to not get in its way. See tests/mail/test_store.py's
# test_wal_db_opens_mode_ro_after_writer_closes for the SQLite/WAL side of this.
ReadWritePaths=__STATE_DIR__
ReadWritePaths=/run/life-agent
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
