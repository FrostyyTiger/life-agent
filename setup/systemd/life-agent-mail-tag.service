[Unit]
Description=life-agent: tag new mail via claude -p, then process digest-reply feedback
After=network-online.target
Wants=network-online.target

# TEMPLATE — substitute __OWNER__, __CODE_DIR__, __DATA_DIR__, __CONF_DIR__,
# __STATE_DIR__ and __CLAUDE_BIN_DIR__ before installing. See setup/README.md.

[Service]
Type=oneshot
User=life-agent
Group=life-agent
# 0007, not 0077: files this unit creates in __DATA_DIR__ (mail-feedback.jsonl) must
# stay group-readable/writable so the owner (a member of group life-agent) and the
# publish job can read them. __STATE_DIR__ stays private regardless of this — its own
# 0700 directory mode blocks group access entirely, independent of file-level bits.
UMask=0007
WorkingDirectory=__CODE_DIR__
Environment=HOME=/var/lib/life-agent
Environment=LIFE_AGENT_DATA=__DATA_DIR__
Environment=LIFE_AGENT_CONF=__CONF_DIR__
Environment=LIFE_AGENT_STATE=__STATE_DIR__
Environment=PATH=/usr/bin:/bin:__CODE_DIR__/.venv/bin:__CLAUDE_BIN_DIR__
# `mail tag` already runs feedback processing at the end of every call (src/mail/cli.py
# cmd_tag) — no separate `mail feedback` invocation needed here.
ExecStart=__CODE_DIR__/.venv/bin/python -m src.mail.cli tag

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__STATE_DIR__ __DATA_DIR__
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

TimeoutStartSec=10min
