# /etc/default/personal on the Proxmox host. Read by the personal-* scripts and pbs-host-backup.
POOL=personal                  # ZFS pool on the removable archive disk
DATASET=personal/data          # shared into the VM via a virtiofs directory mapping
MOUNT=/personal/data           # chattr +i on the empty mountpoint, so nothing writes there while the disk is out
VMID=101                       # the personal VM (stopped while the pool is exported: virtiofsd holds the dataset open)
# pbs-host-backup
PBS_REPOSITORY='user@pbs!token@<pbs-host>:<datastore>'
PBS_FINGERPRINT='<pbs certificate fingerprint>'
PBS_SECRET_FILE=/root/pbs-tokens/hostfiles.secret
PBS_KEYFILE=/root/pbs-encryption-key.json
BACKUP_ID="$(hostname)"
