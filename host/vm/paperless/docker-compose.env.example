# Paperless-ngx settings. Copy to docker-compose.env, chmod 600, fill in. See https://docs.paperless-ngx.com/configuration/
USERMAP_UID=1000
USERMAP_GID=1000
PAPERLESS_URL=https://<host>.<tailnet>.ts.net
PAPERLESS_TIME_ZONE=<Region/City>
PAPERLESS_OCR_LANGUAGE=deu+eng
PAPERLESS_OCR_LANGUAGES=fra ita
PAPERLESS_CONSUMER_RECURSIVE=true
PAPERLESS_CONSUMER_SUBDIRS_AS_TAGS=true
PAPERLESS_CONSUMER_DELETE_DUPLICATES=true
PAPERLESS_FILENAME_FORMAT={{ created_year }}/{{ correspondent }}/{{ title }}
PAPERLESS_DBUSER=paperless
PAPERLESS_DBNAME=paperless
# Secrets: generate on the host, never commit.
#   PAPERLESS_SECRET_KEY=$(openssl rand -hex 32)
#   PAPERLESS_DBPASS=<same value as POSTGRES_PASSWORD in db.env>
